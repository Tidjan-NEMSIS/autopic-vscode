{
  "name": "autopic-vscode",
  "displayName": "Autopic Studio — Smart Illustrations",
  "description": "Interactive illustration studio for VS Code, Cursor, Windsurf & Antigravity. Auto-palette detection, multi-provider search & 1-click cursor insertion.",
  "version": "0.1.3",
  "publisher": "tidjan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tidjan-NEMSIS/autopic-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Visualization"
  ],
  "keywords": [
    "svg",
    "illustrations",
    "undraw",
    "openpeeps",
    "iradesign",
    "react",
    "nextjs",
    "tailwind",
    "palette"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "activationEvents": [
    "onView:autopic.sidebarView",
    "onCommand:autopic.openStudio",
    "onCommand:autopic.insertAtCursor"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autopic-sidebar-container",
          "title": "Autopic Studio",
          "icon": "assets/icons/autopic.svg"
        }
      ]
    },
    "views": {
      "autopic-sidebar-container": [
        {
          "type": "webview",
          "id": "autopic.sidebarView",
          "name": "Autopic Studio",
          "contextualTitle": "Autopic Illustrations"
        }
      ]
    },
    "commands": [
      {
        "command": "autopic.openStudio",
        "title": "Autopic: Open Illustration Studio (Full Screen)",
        "icon": "$(layout)"
      },
      {
        "command": "autopic.insertAtCursor",
        "title": "Autopic: Insert Illustration at Cursor",
        "icon": "$(plus)"
      },
      {
        "command": "autopic.refresh",
        "title": "Autopic: Refresh Project Palette & Context",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "autopic.insertAtCursor",
          "when": "editorTextFocus",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "autopic.openStudio",
          "when": "view == autopic.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "autopic.refresh",
          "when": "view == autopic.sidebarView",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build:host": "node esbuild.config.js --production",
    "watch:host": "node esbuild.config.js --watch",
    "build:webview": "npm run build --prefix webview-ui",
    "build": "npm run build:webview && npm run build:host",
    "package": "npm run build && vsce package --no-dependencies",
    "compile": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "myonlinecv-next": "file:../myonlinecv-next",
    "tidjan-autopic": "^2.0.1"
  }
}
